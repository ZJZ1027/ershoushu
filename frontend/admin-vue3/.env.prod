# 生产环境：只在打包时使用
NODE_ENV=production

VITE_DEV=false

# 后端地址。前后端同域部署时留空即可（走相对路径，由 Nginx 反代 /admin-api）
VITE_BASE_URL=''

# 接口地址（与后端 server.servlet.context-path 保持一致）
VITE_API_URL=/admin-api

# 是否删除debugger
VITE_DROP_DEBUGGER=true

# 是否删除console.log
VITE_DROP_CONSOLE=true

# 是否sourcemap
VITE_SOURCEMAP=false

# 打包路径（部署到子目录时改成 /admin-ui/ 这类前缀，需与 Nginx location 一致）
VITE_BASE_PATH=/

# 输出路径
VITE_OUT_DIR=dist
