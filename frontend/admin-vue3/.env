# 标题（浏览器标签、登录页与导航栏品牌名都取这里）
VITE_APP_TITLE=校园二手书管理

# 项目本地运行端口号
VITE_PORT=80

# open 运行 pnpm dev 时自动打开浏览器
VITE_OPEN=true

# 租户开关（关闭后登录页不再要求填租户名，后端也要同步关 basepro.tenant.enabled）
VITE_APP_TENANT_ENABLE=true

# 默认账户密码（填了会在登录表单预填，仅供本地联调，上线前务必清空）
VITE_APP_DEFAULT_LOGIN_TENANT =
VITE_APP_DEFAULT_LOGIN_USERNAME =
VITE_APP_DEFAULT_LOGIN_PASSWORD =
